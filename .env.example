# Masukkan Token bot Discord kamu dari Discord Developer Portal
DISCORD_TOKEN=your_bot_token_here

# (Opsional tapi disarankan untuk Slash Command)
# Client ID / Application ID dari menu General Information di Developer Portal
CLIENT_ID=your_client_id_here
# Guild ID / Server ID (jika ingin deploy slash command instan ke 1 server uji coba)
GUILD_ID=your_guild_id_here

# Google Gemini API Key (Dapatkan gratis di https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
